  "termsNoteBox": "This is a UI/UX mock-up of sample terms content. Before any official publication, REEL should have the text reviewed by counsel to ensure compliance with current law.",
  "termsContactEmail": "support@reel.studio",
  "termsContactLabel": "Support email",
  "termsContactButton": "Contact support",
  "termsS01Title": "Acceptance of terms",
  "termsS01P1": "By creating an account or using any REEL feature (image generation, video generation, top-up credit, plan upgrade), you agree to the terms below. If you disagree, please stop using the service.",
  "termsS01P2": "REEL is for users aged 13 and over. Users under 18 need the consent of a parent or legal guardian.",
  "termsS02Title": "Account",
  "termsS02P1": "Each account is tied to one unique email address. You are responsible for keeping your password confidential and for every activity that occurs under your account.",
  "termsS02B1": "Registration details (name, email) must be accurate and kept up to date.",
  "termsS02B2": "REEL may require email verification before activating certain features.",
  "termsS02B3": "Accounts may be active, inactive or banned depending on usage history and any violations.",
  "termsS03Title": "Credit & AI generation",
  "termsS03P1": "REEL runs on a credit system. Every image or video generation deducts the corresponding credit from your wallet, depending on type, resolution and duration.",
  "termsS03B1": "Credits are deducted when the generation request begins processing.",
  "termsS03B2": "If a generation fails due to a system error, the credits are automatically refunded.",
  "termsS03B3": "REEL does not refund credits when a request fails because it violated the terms (see Section 6).",
  "termsS03B4": "Unused credits from monthly/yearly plans do not roll over to the next cycle unless stated otherwise.",
  "termsS04Title": "Payment & refund",
  "termsS04P1": "REEL accepts payment via Momo, ZaloPay, VNPay, bank transfer and Stripe (for international plans). Every transaction is recorded with its own ID for traceability.",
  "termsS04B1": "Monthly/yearly plans auto-renew unless you cancel before the next cycle.",
  "termsS04B2": "Refund requests are considered within 7 days of payment, provided the plan credits were not used.",
  "termsS04B3": "One-time credit top-ups are non-refundable once the credits have been added to your wallet.",
  "termsS05Title": "Content ownership",
  "termsS05P1": "You retain usage rights to the content you create on REEL, within the scope of your current plan.",
  "termsS05B1": "Free plan: output carries a REEL watermark and is for personal, non-commercial use.",
  "termsS05B2": "Pro plan: output has no watermark and may be used commercially.",
  "termsS05B3": "REEL does not warrant that AI output is original; you are responsible for checking it before commercial use.",
  "termsS06Title": "Prohibited conduct",
  "termsS06P1": "You must not use REEL to create or distribute content that:",
  "termsS06B1": "Violates current law, incites violence, discrimination or hate speech.",
  "termsS06B2": "Is pornographic or involves minors in any form.",
  "termsS06B3": "Impersonates others, invades privacy or uses someone's likeness without permission.",
  "termsS06B4": "Infringes copyright, trademark or other intellectual-property rights of third parties.",
  "termsS06P2": "Violations may lead to an account being banned without prior notice and with no refund of credits or fees paid.",
  "termsS07Title": "Limitation of liability",
  "termsS07P1": "The service is provided \"as is\". REEL does not guarantee uninterrupted or error-free service, nor that every result will meet your expectations.",
  "termsS07P2": "To the maximum extent permitted by law, REEL is not liable for indirect damages arising from your use of or inability to use the service.",
  "termsS08Title": "Account termination",
  "termsS08P1": "You may stop using the service and request deletion of your account at any time. REEL may suspend (inactive) or permanently lock (banned) accounts that violate the terms, after considering the severity of the violation.",
